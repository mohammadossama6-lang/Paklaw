# Neon Postgres connection string — get it from your Neon project dashboard
# (Connection Details -> "Pooled connection" is recommended for serverless).
DATABASE_URL=

# The same database, but the DIRECT (unpooled) endpoint — the same host with
# the "-pooler" part removed. `npm run build` runs `prisma migrate deploy`, and
# migrations cannot run over Neon's PgBouncer pooler. If unset, the CLI falls
# back to DATABASE_URL, which is fine only when that is already unpooled.
DIRECT_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# GoHighLevel Private Integration token — create one under
# Settings -> Private Integrations in your GHL sub-account, with the
# contacts.write, contacts.readonly, opportunities.write,
# opportunities.readonly, objects/schema.readonly, objects/schema.write,
# objects/record.readonly, objects/record.write, locations/customFields.readonly,
# and locations/customFields.write scopes enabled.
GHL_API_KEY="pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# GoHighLevel Location (sub-account) ID — found in Settings -> Business
# Profile, or in the URL when viewing that sub-account.
GHL_LOCATION_ID="xxxxxxxxxxxxxxxxxxxxxxxx"

# The pipeline + stage new client leads should land in. Fetch via
# GET /opportunities/pipelines (needs opportunities.readonly scope).
GHL_PIPELINE_ID="xxxxxxxxxxxxxxxxxxxxxxxx"
GHL_PIPELINE_STAGE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Lawyers are stored as a "Lawyer" Custom Object (key: custom_objects.lawyer)
# in GHL, not as Contacts — see lib/ghl.ts. No separate pipeline needed.

# Vercel Blob storage token for CV uploads — create a Blob store under your
# Vercel project's Storage tab, then copy the "BLOB_READ_WRITE_TOKEN".
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"

# Signs the portal session cookie (jose/JWT). Generate with: openssl rand -base64 32
SESSION_SECRET=

# WhatsApp Cloud API — delivers portal login codes (see lib/whatsapp.ts).
# Without both of these, /api/auth/otp returns 502 in production and nobody can
# log in; in development the code is logged to the console instead.
# Get these from Meta Business Manager -> WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Name and language of the approved Authentication-category message template
# whose body takes the code as its single variable. Optional — these defaults
# apply if unset.
WHATSAPP_OTP_TEMPLATE="otp_login"
WHATSAPP_TEMPLATE_LOCALE="en""xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
